{
  "schema_version": 1,
  "mode": "template",
  "profile": null,
  "repository": "danielep71/GITHUB-TEMPLATE",
  "required_paths": [
    ".editorconfig",
    ".gitattributes",
    ".github/labels.json",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/repository-profile.json",
    ".github/scripts/labels-sync.mjs",
    ".github/workflows/labels-sync.yml",
    ".github/workflows/static-checks.yml",
    ".gitignore",
    "assets/README.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "docs/README.md",
    "docs/REPOSITORY_STRUCTURE.md",
    "examples/README.md",
    "INSTALLATION.md",
    "LICENSE",
    "README.md",
    "RELEASING.md",
    "SECURITY.md",
    "src/README.md",
    "tests/README.md",
    "tools/check_repo.py",
    "tools/README.md",
    "VERSION"
  ],
  "required_directories": [
    "assets",
    "docs",
    "examples",
    "src",
    "tests",
    "tools"
  ],
  "profiles": {
    "application": {
      "required_paths": [],
      "required_directories": [
        "src/classes",
        "src/modules",
        "src/workbook",
        "tests/modules"
      ]
    },
    "library": {
      "required_paths": [],
      "required_directories": [
        "src/modules",
        "tests/modules"
      ]
    },
    "ui-component": {
      "required_paths": [],
      "required_directories": [
        "src/classes",
        "src/modules",
        "tests/modules"
      ]
    }
  },
  "allowed_office_binary_globs": [],
  "placeholders": {
    "pattern": "\\[[A-Z][A-Z0-9_ .:/,+()&-]*\\]",
    "allowed": [
      "[ADD PROJECT-SPECIFIC TEST ORDER, COMMANDS, AND EVIDENCE REQUIREMENTS.]",
      "[AUTHORITATIVE PRODUCTION SOURCE MANIFEST OR LINK]",
      "[BACK UP THE DESTINATION HOST.]",
      "[CHANGED BEHAVIOR, CONTRACT, TOOLING, OR DOCUMENTATION.]",
      "[COMPLETE REGRESSION OR CERTIFICATION ENTRY POINT]",
      "[CONFIGURE REQUIRED REFERENCES, CALLBACKS, OR WORKBOOK LIFECYCLE CODE.]",
      "[CORRECTED DEFECT AND USER-VISIBLE EFFECT.]",
      "[ERROR AND CLEANUP TEST.]",
      "[EVIDENCE ACTUALLY PRODUCED, INCLUDING ENVIRONMENT AND LIMITATIONS.]",
      "[EXCEL HOST OR UI INTEGRATION]",
      "[EXCEL REGRESSION ENTRY POINT]",
      "[IMPORT EVERY REQUIRED SOURCE COMPONENT IN DEPENDENCY ORDER.]",
      "[IMPORT ORDER]",
      "[INTERNAL OR CORE ENGINE]",
      "[MAJOR.MINOR.PATCH]",
      "[MAJOR]",
      "[MINOR]",
      "[NEW CAPABILITY OR SUPPORTED SURFACE.]",
      "[ONE-SENTENCE PROJECT PURPOSE]",
      "[OPTIONAL PATH]",
      "[OPTIONAL UI OR MANUAL SMOKE ENTRY POINT]",
      "[PATCH]",
      "[PLATFORM / BITNESS / UI / NUMERICAL TEST AS APPLICABLE.]",
      "[PROJECT PROFILE]",
      "[PROJECT-SPECIFIC CHANGE TYPE]",
      "[PROJECT-SPECIFIC HOST OR TOOL VERSION]",
      "[PROJECT_NAME]",
      "[PROJECT_TAGLINE]",
      "[PUBLIC API OR USER SURFACE]",
      "[REPOSITORY PATH]",
      "[REQUIRED UI OR MANUAL SMOKE TESTS]",
      "[RESPONSIBILITY]",
      "[RUN THE CONSUMER SMOKE TESTS.]",
      "[RUN THE PROJECT-SPECIFIC CLEANUP OR RESTORE PROCEDURE.]",
      "[SAFELY DISCLOSABLE SECURITY CORRECTION.]",
      "[STARTUP OR PUBLIC-API SMOKE TEST.]",
      "[STATE THE PROJECT LICENSE BEFORE PUBLISHING THIS TEMPLATE.]",
      "[STATIC CHECK COMMAND]",
      "[SUPPORTED EXCEL / OFFICE HOSTS]",
      "[SUPPORTED OFFICE BITNESS]",
      "[TEST / DEMO / RIBBON / TOOLING PURPOSE]",
      "[TEST OR EVIDENCE SYSTEM]",
      "[UNRESOLVED OR DELIBERATE BOUNDARY.]",
      "[UPGRADE OR MIGRATION IMPACT.]",
      "[VBE COMPONENT]",
      "[VERSIONED SOURCE FILES]",
      "[X.Y.Z]"
    ],
    "required": [
      "[PROJECT_NAME]",
      "[PROJECT_TAGLINE]"
    ],
    "exclude_paths": [
      ".editorconfig",
      ".github/repository-profile.json",
      "tools/check_repo.py"
    ]
  },
  "identity": {
    "forbidden_tokens": [
      "EXCEL-VBA-LOGISTIC-REGRESSION",
      "KPR",
      "VBA-DATETIMEPICKER",
      "VBA-EXCEL_UI",
      "VBA-PERFORMANCE_MANAGER",
      "VBA-PROBABILITY-DISTRIBUTIONS",
      "VBA-PROGRESS_BAR"
    ],
    "template_tokens": [
      "GITHUB-TEMPLATE"
    ],
    "exclude_paths": [
      ".github/repository-profile.json",
      "docs/IMPLEMENTATION_PLAN.md",
      "docs/PORTFOLIO_AUDIT.md"
    ]
  },
  "vba": {
    "source_roots": [
      "src"
    ],
    "test_roots": [
      "tests"
    ],
    "components": {},
    "public_api_manifest": null
  }
}
